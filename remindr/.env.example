# Required in production
OPENAI_API_KEY=
MONGODB_URI=mongodb://localhost:27018
MONGODB_DATABASE=care_companion
# Linq base URL and token provided by Linq. Keep empty to use the safe console adapter.
LINQ_API_BASE_URL=https://api.linqapp.com/api/partner/v3
LINQ_API_TOKEN=
LINQ_WEBHOOK_SECRET=replace-me
LINQ_SEND_MAX_ATTEMPTS=3
DEFAULT_TIMEZONE=America/New_York
SCHEDULER_POLL_SECONDS=30
AUTO_SEED_EXAMPLE_INTAKE=true
